# HSAFX World App - Server Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# APP SETTINGS
# =============================================================================
APP_NAME=HSAFX World App
VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-endpoint.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# =============================================================================
# AUTH
# =============================================================================
SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_SECRET=your-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://hsafx.world","https://admin.hsafx.world"]

# =============================================================================
# STRIPE
# =============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_PROFESSIONAL=price_...

# =============================================================================
# AWS S3
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=hsafx-uploads

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_FREE=60
RATE_LIMIT_PREMIUM=300
RATE_LIMIT_PROFESSIONAL=1000

# =============================================================================
# COINS
# =============================================================================
DAILY_COIN_REWARD=10
REFERRAL_COIN_REWARD=50
AD_WATCH_COIN_REWARD=5

# =============================================================================
# TOOLS
# =============================================================================
TOOL_TIMEOUT_SECONDS=30
MAX_FILE_SIZE_MB=50

# =============================================================================
# MONITORING
# =============================================================================
SENTRY_DSN=

# =============================================================================
# SEAPORT TERMINAL SCRAPERS (Tool 446)
# =============================================================================
# Enabled terminals (comma-separated)
TERMINALS_ENABLED=QICT,KICT,KGTL,SAPT

# KICT (Karachi International Container Terminal)
KICT_HISTORY_URL=https://kictl.com/Enquiries/ContainerHistory
KICT_DETAILS_URL=https://kictl.com/Enquiries/ContainerDetails
KICT_VESSEL_URL=https://kictl.com/Enquiries/VesselSchedule
KICT_SSL_VERIFY=false

# KGTL (Karachi Gateway Terminal Limited)
KGTL_TRACK_URL=https://www.kgtl.com.pk/en/online-tracking
KGTL_VESSEL_PAGE=https://www.kgtl.com.pk/en/vessel-schedule

# QICT (Qasim International Container Terminal)
QICT_API_URL=https://lfs.qict.com.pk/API/api/ds/v1/Ctr-Inq
QICT_VESSEL_URL=https://lfs.qict.com.pk/API/api/ds/v1/V-Berth
QICT_USER_ID=Test
QICT_PASSWORD=Test
QICT_CELL_NO=123456

# SAPT (South Asia Pakistan Terminal)
SAPT_HISTORY_URL=https://www.sapt.com.pk/Enquiries/ContainerHistory
SAPT_DETAILS_URL=https://www.sapt.com.pk/Enquiries/ContainerDetails
SAPT_VESSEL_URL=https://www.sapt.com.pk/Enquiries/VesselSchedule

# Scraper Performance Settings
REQUEST_TIMEOUT=30
CONNECTION_TIMEOUT=10
CACHE_TTL=300

# Connection Pool
SCRAPER_MAX_KEEPALIVE=50
SCRAPER_MAX_CONNECTIONS=100
SCRAPER_KEEPALIVE_EXPIRY=30

# User Agent
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0
SCRAPER_ACCEPT_LANGUAGE=en-US,en;q=0.9

# SSL Certificate Bundle (for corporate proxies, leave empty if not needed)
SCRAPER_CA_BUNDLE=

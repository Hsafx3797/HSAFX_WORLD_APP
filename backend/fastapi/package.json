{
  "name": "@hsafx/fastapi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": ".venv\\Scripts\\python.exe -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uvicorn src.main:app --host 0.0.0.0 --port 8000",
    "lint": "python -m ruff check src",
    "lint:fix": "python -m ruff check src --fix",
    "format": "python -m ruff format src",
    "test": "python -m pytest tests -v",
    "test:coverage": "python -m pytest tests -v --cov=src --cov-report=term-missing",
    "typecheck": "echo Python type checking requires pyright - skipping"
  }
}

# ========================================
# HSAFX WORLD - Root Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ========================================
# DEPLOYMENT
# ========================================
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3000/api

# Region: Singapore (ap-southeast-1)
DEPLOYMENT_REGION=ap-southeast-1

# ========================================
# DATABASE (Neon PostgreSQL)
# ========================================
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-endpoint.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:your_password_here@ep-your-endpoint.neon.tech/neondb?sslmode=require

# ========================================
# REDIS (Upstash)
# ========================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ========================================
# AUTHENTICATION (Better-Auth)
# ========================================
AUTH_SECRET=your-super-secret-auth-key-min-32-chars
AUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

META_CLIENT_ID=your_meta_client_id
META_CLIENT_SECRET=your_meta_client_secret

# ========================================
# BILLING & PAYMENTS
# ========================================
# Polar (Subscription Management)
POLAR_ACCESS_TOKEN=polar_test_xxx
POLAR_WEBHOOK_SECRET=whsec_xxx
POLAR_ORGANIZATION_ID=org_xxx

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ========================================
# OBJECT STORAGE (Cloudflare R2)
# ========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=hsafx-uploads
R2_PUBLIC_URL=https://uploads.hsafx.world

# ========================================
# INTERNAL SERVICES
# ========================================
# FastAPI Backend (Python)
FASTAPI_URL=http://localhost:8000
FASTAPI_INTERNAL_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=your-internal-service-secret-key
INTERNAL_API_SECRET=your-internal-api-secret-key-min-32-chars
NEXTJS_CALLBACK_URL=http://localhost:3000/api/internal/job-complete

# ========================================
# BACKGROUND JOBS (Inngest)
# ========================================
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ========================================
# SEARCH (Meilisearch)
# ========================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# ========================================
# MONITORING & ANALYTICS
# ========================================
# Error Tracking (Sentry)
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Analytics (Plausible)
PLAUSIBLE_DOMAIN=hsafx.world
PLAUSIBLE_API_KEY=your_plausible_api_key

# ========================================
# EMAIL (Resend)
# ========================================
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@hsafx.world

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ========================================
# FEATURE FLAGS
# ========================================
FEATURE_TOOLS_GROUP_1_ENABLED=true
FEATURE_TOOLS_GROUP_2_ENABLED=true
FEATURE_TOOLS_GROUP_3_ENABLED=true
FEATURE_TOOLS_GROUP_4_ENABLED=true
FEATURE_TOOLS_GROUP_5_ENABLED=false
FEATURE_API_ACCESS_ENABLED=true
FEATURE_ADMIN_PANEL_ENABLED=true

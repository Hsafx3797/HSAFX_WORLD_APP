# ========================================
# HSAFX WORLD - Environment Variables
# ========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ========================================
# DEPLOYMENT
# ========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3000/api

# ========================================
# DATABASE (Neon PostgreSQL)
# ========================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ========================================
# AUTHENTICATION (Better-Auth)
# ========================================
BETTER_AUTH_SECRET=           # REQUIRED: min 32 characters

# ========================================
# EMAIL (Resend)
# ========================================
RESEND_API_KEY=               # Optional: Resend.com API key
EMAIL_FROM=noreply@yourdomain.com

# ========================================
# INTERNAL SERVICES
# ========================================
FASTAPI_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=      # REQUIRED: shared secret for inter-service auth
INTERNAL_API_SECRET=          # REQUIRED: 48-char hex string

# ========================================
# CRON / SCHEDULED JOBS
# ========================================
CRON_SECRET=                  # REQUIRED: 48-char hex string

# ========================================
# ENCRYPTION (64-char hex — API key encryption)
# ========================================
ENCRYPTION_KEY=               # REQUIRED: 64-char hex string

# ========================================
# FASTAPI BACKEND
# ========================================
DEBUG=true
SECRET_KEY=                   # REQUIRED: min 32 characters
INTERNAL_SECRET=              # REQUIRED: same as INTERNAL_SERVICE_SECRET

# ========================================
# REDIS (Upstash)
# ========================================
UPSTASH_REDIS_REST_URL=       # REQUIRED: https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=     # REQUIRED: Upstash REST token
REDIS_URL=                    # Optional: rediss://default:token@host:6379

# ========================================
# BILLING (Stripe — B2B + Coin Packs)
# ========================================
STRIPE_SECRET_KEY=            # Optional: Stripe secret key
STRIPE_PUBLISHABLE_KEY=       # Optional: Stripe publishable key (client-side)
STRIPE_WEBHOOK_SECRET=        # Optional: Stripe webhook signing secret
STRIPE_USAGE_METER_NAME=api_calls  # Stripe Billing Meter event name for B2B usage

# ========================================
# BILLING (Polar — B2C)
# ========================================
POLAR_ACCESS_TOKEN=           # Optional: Polar access token
POLAR_WEBHOOK_SECRET=         # Optional: Polar webhook secret

# ========================================
# OBSERVABILITY
# ========================================
OTEL_EXPORTER_OTLP_ENDPOINT=  # Optional: OpenTelemetry collector endpoint

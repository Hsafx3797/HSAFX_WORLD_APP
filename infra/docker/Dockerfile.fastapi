# ═══════════════════════════════════════════════════════════════
# HSAFX World App — FastAPI Backend Dockerfile
# Includes native binaries: FFmpeg, Poppler, Tesseract, libvips
# ═══════════════════════════════════════════════════════════════

# ── Build stage (compile C extensions) ────────────────────────
FROM python:3.15-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libvips-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Runtime stage ─────────────────────────────────────────────
FROM python:3.15-slim AS base

# Runtime-only native dependencies (no compilers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Media processing
    ffmpeg \
    # Image processing (libvips for advanced ops)
    libvips-dev \
    libvips-tools \
    # PDF processing (Poppler suite)
    poppler-utils \
    # OCR
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-ara \
    # HTML-to-PDF
    wkhtmltopdf \
    # Utility
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── App setup ─────────────────────────────────────────────────
WORKDIR /app

# Copy pre-built Python packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY src/ ./src/

# ── Runtime config ────────────────────────────────────────────
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe \
    TESSERACT_PATH=/usr/bin/tesseract \
    # Max upload size: 100MB
    MAX_UPLOAD_SIZE=104857600

# Non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser && \
    mkdir -p /app/tmp && chown -R appuser:appuser /app
USER appuser

# Temp dir for tool processing
ENV TMPDIR=/app/tmp

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with uvicorn
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

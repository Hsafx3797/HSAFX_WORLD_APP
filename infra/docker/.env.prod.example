# ═══════════════════════════════════════════════════════════════
# HSAFX World App — Production Environment Variables
# Copy to .env and fill in all required values
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=hsafx
POSTGRES_USER=hsafx
POSTGRES_PASSWORD=       # REQUIRED: strong random password

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=          # REQUIRED: strong random password

# ── FastAPI ────────────────────────────────────────────────────
SECRET_KEY=              # REQUIRED: 64-char hex string
INTERNAL_SECRET=         # REQUIRED: shared secret for inter-service auth (FastAPI + Rust)
SENTRY_DSN=

# ── Next.js (core) ────────────────────────────────────────────
BETTER_AUTH_SECRET=      # REQUIRED: 64-char hex string
ENCRYPTION_KEY=          # REQUIRED: 64-char hex string (API key encryption)
CRON_SECRET=             # REQUIRED: secret for cron job auth
INTERNAL_API_SECRET=     # REQUIRED: same as INTERNAL_SECRET (Rust/FastAPI inter-service auth)
NEXT_PUBLIC_APP_URL=https://hsafx.world
NEXT_PUBLIC_ADMIN_URL=https://admin.hsafx.world
NEXT_PUBLIC_FASTAPI_URL=http://fastapi:8000
RUST_ENGINE_URL=http://rust-engine:3001
FASTAPI_URL=http://fastapi:8000

# ── Redis (Upstash-compatible for Better-Auth sessions) ───────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── OAuth Providers ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=

# ── Billing (Polar) ───────────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=


# ── Storage (Cloudflare R2 / S3-compatible) ───────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hsafx-uploads

# ── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=  # Optional: OpenTelemetry collector endpoint
METRICS_SECRET=                # Optional: Bearer token for /api/metrics

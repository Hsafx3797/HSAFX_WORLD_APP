# Docker Compose Environment Variables
# Copy this file to .env in the same directory

# ========================================
# PostgreSQL
# ========================================
POSTGRES_PASSWORD=hsafx_local_dev

# ========================================
# FastAPI
# ========================================
SECRET_KEY=dev-secret-key
INTERNAL_SECRET=dev-internal-secret
SENTRY_DSN=

# ========================================
# AWS / Cloudflare R2 (S3-compatible)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hsafx-uploads

# Admin Panel — Environment Variables
# Next.js only loads .env* from its working directory (apps/admin/)
# Copy to .env.local: cp .env.example .env.local

# Database (Neon PostgreSQL) — required by @hsafx/db
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication — required by admin middleware
BETTER_AUTH_SECRET=           # REQUIRED: min 32 characters
AUTH_SECRET=                  # REQUIRED: same as BETTER_AUTH_SECRET

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Redis (Upstash) — required by feature flags
UPSTASH_REDIS_REST_URL=       # REQUIRED: https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=     # REQUIRED: Upstash REST token

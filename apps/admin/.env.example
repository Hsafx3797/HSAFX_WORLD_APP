# ========================================
# HSAFX World Admin Panel Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-endpoint.neon.tech/neondb?sslmode=require

# Authentication (Better-Auth)
AUTH_SECRET=your-super-secret-auth-key-min-32-chars
AUTH_URL=http://localhost:3001

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# FastAPI Backend
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx

# Internal Secret (for service-to-service auth)
INTERNAL_SERVICE_SECRET=your-internal-service-secret

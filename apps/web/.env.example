# Server-side environment variables for Next.js web app
# Next.js only loads .env* from its working directory (apps/web/)
# Copy to .env.local: cp .env.example .env.local

# Database (Neon PostgreSQL) — required by @hsafx/db
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication (Better-Auth) — required by auth session routes
BETTER_AUTH_SECRET=           # REQUIRED: min 32 characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal services
INTERNAL_SERVICE_SECRET=      # REQUIRED: shared secret for inter-service auth
INTERNAL_API_SECRET=          # REQUIRED: 48-char hex string
FASTAPI_URL=http://localhost:8000

# Cron / Scheduled jobs
CRON_SECRET=                  # REQUIRED: 48-char hex string

# Encryption (64-char hex — used for API key encryption)
ENCRYPTION_KEY=               # REQUIRED: 64-char hex string

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=       # REQUIRED: https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=     # REQUIRED: Upstash REST token

# ========================================
# HSAFX World Web App Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-endpoint.neon.tech/neondb?sslmode=require

# Authentication (Better-Auth)
AUTH_SECRET=your-super-secret-auth-key-min-32-chars
AUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# FastAPI Backend
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Stripe (coin-pack one-time purchases only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Polar (subscription billing — Merchant of Record)
POLAR_ACCESS_TOKEN=polar_pat_xxx
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=whsec_xxx

# Analytics (Optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hsafx.world

# Sentry (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

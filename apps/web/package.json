{
  "name": "@hsafx/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sync:wasm && next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "sync:wasm": "node -e \"const fs=require('fs');const s='../../backend/rust/text-tools/pkg/';const d='./public/wasm/';fs.mkdirSync(d,{recursive:true});['text_tools.js','text_tools_bg.wasm'].forEach(f=>{if(fs.existsSync(s+f)){fs.copyFileSync(s+f,d+f);console.log('Synced '+f)}else{console.warn('Missing '+s+f)}})\""
  },
  "dependencies": {
    "@hsafx/api": "workspace:*",
    "@hsafx/db": "workspace:*",
    "@hsafx/schemas": "workspace:*",
    "@hsafx/shared": "workspace:*",
    "@hsafx/theme": "workspace:*",
    "@hsafx/tool-definitions": "workspace:*",
    "@hsafx/tool-execution": "workspace:*",
    "@hsafx/ui": "workspace:*",
    "@polar-sh/sdk": "^0.43.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@sentry/nextjs": "^10.38.0",
    "@tanstack/react-query": "^5.75.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.35.0",
    "better-auth": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^0.514.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.1.0",
    "sonner": "^2.0.0",
    "stripe": "^20.3.1",
    "superjson": "^2.2.1",
    "svix": "^1.84.1",
    "tailwind-merge": "^3.0.0",
    "wcag-contrast": "^3.0.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
